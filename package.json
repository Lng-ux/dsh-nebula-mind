{
  "name": "dsh-nebula-mind",
  "version": "0.6.1",
  "private": false,
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "python/*.py",
    "screenshots.json",
    "docs/shots"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "description": "记忆星图 · DeepSeek Harness 外置长期记忆：跨会话、抗压缩，零依赖（自带 48MB 语义模型，numpy 推理，不需要 torch）；三路召回（BM25 / 稠密向量 / PPR 图扩散）经 RRF 融合、情绪作调制乘子；幂律遗忘与五层沉海、突触标记与捕获；可交互的记忆星图。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "long-term-memory",
    "cross-session",
    "knowledge-graph",
    "hybrid-retrieval",
    "bm25",
    "ppr",
    "rrf",
    "forgetting-curve",
    "emotion",
    "visualization",
    "zero-dependency"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.3",
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check lib/host.js",
    "doctor": "python python/doctor.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lng-ux/dsh-nebula-mind.git"
  },
  "homepage": "https://github.com/Lng-ux/dsh-nebula-mind#readme",
  "bugs": {
    "url": "https://github.com/Lng-ux/dsh-nebula-mind/issues"
  },
  "author": "Lng-ux",
  "publishConfig": {
    "access": "public"
  }
}
